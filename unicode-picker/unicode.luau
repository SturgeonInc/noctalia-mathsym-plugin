--!nonstrict
-- Unicode picker launcher provider.
--
-- Type `/uni` followed by a LaTeX command name (`\alpha`, `leq`, `mathbb{R}`) or a
-- Lean 4 VS Code abbreviation (`Rightarrow`, `nat`, `<=`) to find the character;
-- anything else is matched against the character's description ("integral").
-- Enter copies the character to the clipboard.
--
-- data.tsv is generated by tools/build_data.py. One line per character:
--   char <TAB> latex names <TAB> lean names <TAB> description <TAB> class
-- It is parsed lazily on the first query with plain string ops (no JSON decode)
-- to stay inside the per-call time budget.

local RESULT_LIMIT = 50

local NOTIFY = noctalia.getConfig("notify_on_copy")
NOTIFY = if type(NOTIFY) == "boolean" then NOTIFY else true

-- Lazily loaded + indexed database. nil until the first query.
local db = nil

-- Names are matched with backslashes, braces and spaces removed, so `\mathbb{R}`,
-- `mathbb R` and `mathbbR` are the same query.
local function norm(s)
  return (s:gsub("[\\{}%s]", ""))
end

-- U+0300..036F, U+20D0..20FF, U+FE20..FE2F render badly on their own; put them on a dotted circle.
local function isCombining(ch)
  local cp = utf8.codepoint(ch, 1)
  return (cp >= 0x300 and cp <= 0x36F) or (cp >= 0x20D0 and cp <= 0x20FF) or (cp >= 0xFE20 and cp <= 0xFE2F)
end

local function loadDatabase()
  if db ~= nil then
    return db
  end
  local raw = noctalia.readFile("data.tsv")
  if not raw then
    return nil
  end

  local chars, latex, lean, desc, descLower = {}, {}, {}, {}, {}
  -- Parallel arrays over every searchable name: normalized original-case name,
  -- its lowercase form, and the character index it belongs to.
  local nameCs, nameCi, nameId = {}, {}, {}
  -- Exact-match buckets keyed by normalized name (case-sensitive and -insensitive).
  local exactCs, exactCi = {}, {}

  local function addNames(list, id)
    for name in list:gmatch("%S+") do
      local n = norm(name)
      if n ~= "" then
        local l = n:lower()
        table.insert(nameCs, n)
        table.insert(nameCi, l)
        table.insert(nameId, id)
        local bucket = exactCs[n]
        if not bucket then
          bucket = {}
          exactCs[n] = bucket
        end
        table.insert(bucket, id)
        bucket = exactCi[l]
        if not bucket then
          bucket = {}
          exactCi[l] = bucket
        end
        table.insert(bucket, id)
      end
    end
  end

  local count = 0
  for line in raw:gmatch("[^\n]+") do
    local ch, lt, ln, ds = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)")
    if ch then
      count += 1
      chars[count] = ch
      latex[count] = lt
      lean[count] = ln
      desc[count] = ds
      descLower[count] = ds:lower()
      addNames(lt, count)
      addNames(ln, count)
    end
  end

  db = {
    count = count,
    chars = chars,
    latex = latex,
    lean = lean,
    desc = desc,
    descLower = descLower,
    nameCs = nameCs,
    nameCi = nameCi,
    nameId = nameId,
    exactCs = exactCs,
    exactCi = exactCi,
  }
  return db
end

-- Show up to `limit` names as `\name`, in file order.
local function nameList(names, limit)
  local out, n = {}, 0
  for name in names:gmatch("%S+") do
    n += 1
    if n > limit then
      table.insert(out, "…")
      break
    end
    table.insert(out, "\\" .. name)
  end
  return table.concat(out, " ")
end

local function row(d, id, score)
  local ch = d.chars[id]
  local title = ch
  local cp = utf8.codepoint(ch, 1)
  if utf8.len(ch) == 1 and isCombining(ch) then
    title = "\u{25CC}" .. ch
  end

  local parts = {}
  if d.latex[id] ~= "" then
    table.insert(parts, nameList(d.latex[id], 3))
  end
  if d.lean[id] ~= "" then
    table.insert(parts, "Lean: " .. nameList(d.lean[id], 3))
  end
  if d.desc[id] ~= "" then
    table.insert(parts, d.desc[id])
  end
  table.insert(parts, string.format("U+%04X", cp))

  return {
    id = "u:" .. ch,
    title = title,
    subtitle = table.concat(parts, "  ·  "),
    glyph = "math-symbols",
    score = score,
  }
end

-- Scores: case-sensitive exact > case-insensitive exact > prefix > substring > description.
-- Shorter names win within prefix/substring so `le` ranks `\le` above `\leftarrow`.
local function search(d, query)
  local token = norm(query)
  local lower = token:lower()
  local best = {}

  local function bump(id, score)
    if score > (best[id] or 0) then
      best[id] = score
    end
  end

  local hit = d.exactCs[token]
  if hit then
    for _, id in hit do
      bump(id, 1000)
    end
  end
  hit = d.exactCi[lower]
  if hit then
    for _, id in hit do
      bump(id, 900)
    end
  end

  local nameCi, nameId = d.nameCi, d.nameId
  local tlen = #lower
  for i = 1, #nameCi do
    local at = nameCi[i]:find(lower, 1, true)
    if at then
      local extra = math.min(#nameCi[i] - tlen, 99)
      bump(nameId[i], if at == 1 then 700 - extra else 500 - extra)
    end
  end

  -- Description words (AND), lower priority; skip for 1-char queries to avoid noise.
  if tlen >= 2 then
    local words = {}
    for w in query:lower():gsub("\\", ""):gmatch("%S+") do
      table.insert(words, w)
    end
    if #words > 0 then
      for id = 1, d.count do
        local hay = d.descLower[id]
        local ok = true
        for _, w in words do
          if not hay:find(w, 1, true) then
            ok = false
            break
          end
        end
        if ok then
          bump(id, 300)
        end
      end
    end
  end

  local ids = {}
  for id in best do
    table.insert(ids, id)
  end
  table.sort(ids, function(a, b)
    local sa, sb = best[a], best[b]
    if sa ~= sb then
      return sa > sb
    end
    return a < b
  end)

  local rows = {}
  for i = 1, math.min(#ids, RESULT_LIMIT) do
    rows[i] = row(d, ids[i], best[ids[i]])
  end
  return rows
end

-- `query` is the launcher text after the `/uni` prefix.
function onQuery(query)
  local d = loadDatabase()
  if not d then
    launcher.setResults(query, {
      { id = "", title = "Database unavailable", subtitle = "Could not load data.tsv", glyph = "alert-triangle" },
    })
    return
  end

  local text = noctalia.string.trim(query)
  if text == "" then
    launcher.setResults(query, {
      {
        id = "",
        title = "Search unicode characters",
        subtitle = "LaTeX name (\\alpha, mathbb{R}), Lean abbreviation (Rightarrow), or description",
        glyph = "math-symbols",
      },
    })
    return
  end

  local rows = search(d, text)
  if #rows == 0 then
    rows[1] = { id = "", title = "No matches", subtitle = "Try a different name", glyph = "mood-empty" }
  end
  launcher.setResults(query, rows)
end

function onActivate(id)
  -- sub() rather than patterns: the payload is an arbitrary character.
  if id:sub(1, 2) ~= "u:" then
    return
  end
  local ch = id:sub(3)
  if ch == "" then
    return
  end
  noctalia.copyToClipboard(ch, "text/plain")
  if NOTIFY then
    noctalia.notify("Unicode", ch .. " copied to clipboard")
  end
end
