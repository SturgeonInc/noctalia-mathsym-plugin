--!nonstrict
-- Unicode picker launcher provider.
--
-- Type `/uni` followed by a LaTeX command name (`\alpha`, `leq`, `mathbb{R}`) or a
-- Lean 4 VS Code abbreviation (`Rightarrow`, `nat`, `<=`) to find the character;
-- anything else is matched against the character's description ("integral").
-- Enter copies the character to the clipboard.
--
-- Data files are generated by tools/build_data.py, one line per character, same order:
--   data.tsv   char <TAB> latex names <TAB> lean names <TAB> description <TAB> class (display)
--   names.txt  normalized names, each wrapped in tabs: "\talpha\tmupalpha\t"
--   desc.txt   lowercase description
-- Callbacks get a 25 ms CPU budget, so nothing is parsed or indexed in Luau: the
-- files are searched as whole strings with plain string.find (C speed) and only the
-- line offsets are computed on load.

local RESULT_LIMIT = 50
-- Max hits examined per search tier; keeps short queries ("a") cheap.
local HIT_LIMIT = 300

local find = string.find

local NOTIFY = noctalia.getConfig("notify_on_copy")
NOTIFY = if type(NOTIFY) == "boolean" then NOTIFY else true

-- Lazily loaded. nil until the first query.
local db = nil

-- Names are matched with backslashes, braces and spaces removed, so `\mathbb{R}`,
-- `mathbb R` and `mathbbR` are the same query.
local function norm(s)
  return (s:gsub("[\\{}%s]", ""))
end

-- U+0300..036F, U+20D0..20FF, U+FE20..FE2F render badly on their own; put them on a dotted circle.
local function isCombining(ch)
  local cp = utf8.codepoint(ch, 1)
  return (cp >= 0x300 and cp <= 0x36F) or (cp >= 0x20D0 and cp <= 0x20FF) or (cp >= 0xFE20 and cp <= 0xFE2F)
end

-- starts[i] = byte offset of line i; starts[n + 1] = one past the end of the last line.
local function lineStarts(blob)
  local starts = { 1 }
  local pos = 1
  while true do
    local nl = find(blob, "\n", pos, true)
    if not nl then
      break
    end
    pos = nl + 1
    table.insert(starts, pos)
  end
  return starts
end

-- Line containing byte offset p (binary search).
local function lineOf(starts, p)
  local lo, hi = 1, #starts - 1
  while lo < hi do
    local mid = (lo + hi + 1) // 2
    if starts[mid] <= p then
      lo = mid
    else
      hi = mid - 1
    end
  end
  return lo
end

local function loadDatabase()
  if db ~= nil then
    return db
  end
  local data = noctalia.readFile("data.tsv")
  local names = noctalia.readFile("names.txt")
  local desc = noctalia.readFile("desc.txt")
  if not data or not names or not desc then
    return nil
  end
  db = {
    data = data,
    dataStarts = lineStarts(data),
    names = names,
    namesLower = names:lower(),
    nameStarts = lineStarts(names),
    desc = desc,
    descStarts = lineStarts(desc),
  }
  db.count = #db.nameStarts - 1
  return db
end

-- Show up to `limit` names as `\name`, in file order.
local function nameList(names, limit)
  local out, n = {}, 0
  for name in names:gmatch("%S+") do
    n += 1
    if n > limit then
      table.insert(out, "…")
      break
    end
    table.insert(out, "\\" .. name)
  end
  return table.concat(out, " ")
end

local function row(d, id, score)
  local line = d.data:sub(d.dataStarts[id], d.dataStarts[id + 1] - 2)
  local ch, latex, lean, desc = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)")
  local title = ch
  local cp = utf8.codepoint(ch, 1)
  if utf8.len(ch) == 1 and isCombining(ch) then
    title = "\u{25CC}" .. ch
  end

  local parts = {}
  if latex ~= "" then
    table.insert(parts, nameList(latex, 3))
  end
  if lean ~= "" then
    table.insert(parts, "Lean: " .. nameList(lean, 3))
  end
  if desc ~= "" then
    table.insert(parts, desc)
  end
  table.insert(parts, string.format("U+%04X", cp))

  return {
    id = "u:" .. ch,
    title = title,
    subtitle = table.concat(parts, "  ·  "),
    glyph = "math-symbols",
    score = score,
  }
end

-- Scores: case-sensitive exact > case-insensitive exact > prefix > substring > description.
-- Shorter names win within prefix/substring so `le` ranks `\le` above `\leftarrow`.
local function search(d, query)
  local token = norm(query)
  local lower = token:lower()
  local tlen = #lower
  local best = {}
  if tlen == 0 then
    return {}
  end

  local function bump(id, score)
    if score > (best[id] or 0) then
      best[id] = score
    end
  end

  -- Call fn(p) for each plain occurrence of `needle` in `blob` (at most HIT_LIMIT).
  local function scan(blob, needle, fn)
    local pos, hits = 1, 0
    while hits < HIT_LIMIT do
      local at = find(blob, needle, pos, true)
      if not at then
        return
      end
      fn(at)
      hits += 1
      pos = at + 1
    end
  end

  local names, namesLower, starts = d.names, d.namesLower, d.nameStarts
  scan(names, "\t" .. token .. "\t", function(p)
    bump(lineOf(starts, p), 1000)
  end)
  scan(namesLower, "\t" .. lower .. "\t", function(p)
    bump(lineOf(starts, p), 900)
  end)
  scan(namesLower, "\t" .. lower, function(p)
    local tab = find(namesLower, "\t", p + 1, true)
    bump(lineOf(starts, p), 700 - math.min(tab - p - 1 - tlen, 99))
  end)
  scan(namesLower, lower, function(p)
    if namesLower:byte(p - 1) ~= 9 then -- prefix hits were scored above
      local tab = find(namesLower, "\t", p, true)
      bump(lineOf(starts, p), 500 - math.min(tab - p, 99))
    end
  end)

  -- Description words (AND), lower priority; skip for 1-char queries to avoid noise.
  if tlen >= 2 then
    local words = {}
    for w in query:lower():gsub("\\", ""):gmatch("%S+") do
      table.insert(words, w)
    end
    local desc, dstarts = d.desc, d.descStarts
    if #words > 0 then
      scan(desc, words[1], function(p)
        local id = lineOf(dstarts, p)
        local limit = dstarts[id + 1]
        for i = 2, #words do
          local at = find(desc, words[i], dstarts[id], true)
          if not at or at >= limit then
            return
          end
        end
        bump(id, 300)
      end)
    end
  end

  local ids = {}
  for id in best do
    table.insert(ids, id)
  end
  table.sort(ids, function(a, b)
    local sa, sb = best[a], best[b]
    if sa ~= sb then
      return sa > sb
    end
    return a < b
  end)

  local rows = {}
  for i = 1, math.min(#ids, RESULT_LIMIT) do
    rows[i] = row(d, ids[i], best[ids[i]])
  end
  return rows
end

-- `query` is the launcher text after the `/uni` prefix.
function onQuery(query)
  local d = loadDatabase()
  if not d then
    launcher.setResults(query, {
      { id = "", title = "Database unavailable", subtitle = "Could not load data files", glyph = "alert-triangle" },
    })
    return
  end

  local text = noctalia.string.trim(query)
  if text == "" then
    launcher.setResults(query, {
      {
        id = "",
        title = "Search unicode characters",
        subtitle = "LaTeX name (\\alpha, mathbb{R}), Lean abbreviation (Rightarrow), or description",
        glyph = "math-symbols",
      },
    })
    return
  end

  local rows = search(d, text)
  if #rows == 0 then
    rows[1] = { id = "", title = "No matches", subtitle = "Try a different name", glyph = "mood-empty" }
  end
  launcher.setResults(query, rows)
end

function onActivate(id)
  -- sub() rather than patterns: the payload is an arbitrary character.
  if id:sub(1, 2) ~= "u:" then
    return
  end
  local ch = id:sub(3)
  if ch == "" then
    return
  end
  noctalia.copyToClipboard(ch, "text/plain")
  if NOTIFY then
    noctalia.notify("Unicode", ch .. " copied to clipboard")
  end
end
